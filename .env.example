# ===== LLM 공급자 설정 =====
# (A) OpenAI 를 쓰는 경우: OPENAI_API_KEY 와 LLM_MODEL 만 설정.
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
# OpenAI 호환 게이트웨이를 쓸 때만 (선택):
# OPENAI_BASE_URL=https://your-gateway/v1

# (B) Azure OpenAI 를 쓰는 경우: 아래 3개를 설정하면 자동으로 Azure 클라이언트 사용.
#     이때 LLM_MODEL 에는 "배포(deployment) 이름"을 넣는다.
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_API_VERSION=2024-10-21
# LLM_MODEL=your-deployment-name

# ===== 채점/서버 튜닝 (선택) =====
JUDGE_COUNT=3
MAX_SUBMISSIONS=4
MAX_CONCURRENCY=6
JUDGE_MAX_RETRIES=3
LLM_REQUEST_TIMEOUT=60
LEADERBOARD_POLL_SECONDS=5
